[Unit]
Description=Yijianjifa private cloud voice account and credit service
After=network.target

[Service]
Type=simple
StartLimitInterval=300
StartLimitBurst=3
User=yjjfvoice
Group=yjjfvoice
WorkingDirectory=/opt/yijianjifa-cloud-voice/current
EnvironmentFile=/etc/yijianjifa-cloud-voice/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/yijianjifa-cloud-voice/current
ExecStart=/opt/yijianjifa-cloud-voice/venv/bin/python /opt/yijianjifa-cloud-voice/current/deploy/production.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
MemoryAccounting=true
MemoryLimit=192M
CPUAccounting=true
CPUQuota=50%
LimitNOFILE=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyDirectories=/opt/yijianjifa-cloud-voice
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
